{
    "compilerOptions": {
        "target": "ES2022",
        "lib": ["ES2022"],
        "module": "Node16",
        "moduleResolution": "Node16",
        "strict": true,
        "noEmit": true,
        "skipLibCheck": false,
        "forceConsistentCasingInFileNames": true,
        "exactOptionalPropertyTypes": false,
        "types": []
    },
    "include": ["test/types/**/*.ts"]
}
