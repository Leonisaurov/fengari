{
  "name": "fengari",
  "version": "0.1.5",
  "description": "A Lua VM written in JS ES6 targeting the browser",
  "main": "src/fengari.js",
  "module": "src/fengari.mjs",
  "types": "types/fengari.d.ts",
  "exports": {
    ".": {
      "types": "./types/fengari.d.ts",
      "import": "./src/fengari.mjs",
      "require": "./src/fengari.js",
      "default": "./src/fengari.js"
    },
    "./versions": "./src/versions.js",
    "./versions/*.js": "./src/versions/*.js",
    "./versions/*": "./src/versions/*.js",
    "./src/*": "./src/*",
    "./*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "src/",
    "docs/",
    "bench/",
    "dist/",
    "types/",
    "README.md",
    "LICENSE",
    "NEWS"
  ],
  "engines": {
    "node": ">=18"
  },
  "type": "commonjs",
  "directories": {
    "lib": "src",
    "test": "test"
  },
  "scripts": {
    "lint": "eslint src/ test/ scripts/",
    "lint:fix": "eslint src/ test/ scripts/ --fix",
    "prepublishOnly": "git diff-index --quiet --cached HEAD -- && npm run lint && npm run test",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:diff": "node scripts/diff-puc.js",
    "test:browser": "node scripts/browser-test.js",
    "build": "node scripts/build-browser.js",
    "prepack": "node scripts/build-browser.js",
    "bench": "node bench/run.js",
    "bench:compare": "node bench/compare.js",
    "bench:compile": "node bench/compile.js",
    "bench:startup": "node bench/startup.js",
    "fuzz": "node scripts/fuzz.js",
    "docs:api": "node scripts/generate-api-docs.js",
    "docs:check": "node scripts/generate-api-docs.js --check",
    "changelog": "node scripts/changelog.js",
    "typecheck": "tsc -p tsconfig.types.json",
    "typecheck:js": "tsc -p tsconfig.checkjs.json",
    "check": "eslint src/ test/ scripts/ && node scripts/generate-api-docs.js --check && tsc -p tsconfig.types.json && tsc -p tsconfig.checkjs.json && jest"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fengari-lua/fengari.git"
  },
  "keywords": [
    "lua",
    "vm"
  ],
  "contributors": [
    "Benoit Giannangeli",
    "Daurnimator <quae@daurnimator.com>"
  ],
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/fengari-lua/fengari/issues"
  },
  "homepage": "https://github.com/fengari-lua/fengari#readme",
  "devDependencies": {
    "@types/node": "*",
    "eslint": "^9.39.2",
    "globals": "^17.13.0",
    "jest": "^30.2.0",
    "sprintf-js": "^1.1.3",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "readline-sync": "^1.4.10",
    "tmp": "^0.2.5"
  },
  "sideEffects": false
}
