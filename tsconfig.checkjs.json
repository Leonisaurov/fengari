{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": false,
    "noImplicitAny": false,
    "skipLibCheck": true,
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "types": ["node"]
  },
  "include": [
    "src/**/*.js",
    "test/types/checkjs-globals.d.ts"
  ],
  "exclude": [
    "src/fengari.mjs"
  ]
}
